---
import MainLayout from '../layouts/MainLayout.astro';
import SyaratDanJadwal from '../components/SyaratDanJadwal.astro';
---

<MainLayout
  title="Syarat Pendaftaran, Biaya & Jadwal Gelombang | PSB PPBH 2027/2028"
  description="Panduan dokumen syarat pendaftaran, rincian biaya Rp 200.000, materi tes seleksi, dan jadwal Gelombang 1 & 2 TP. 2027/2028."
>
  <div class="bg-emerald-950 text-white py-16 text-center">
    <div class="max-w-4xl mx-auto px-4">
      <span class="px-3.5 py-1 bg-gold-500 text-emerald-950 text-xs font-extrabold rounded-full uppercase">Panduan Pendaftaran</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-serif text-white mt-3">Syarat & Alur Seleksi TP. 2027/2028</h1>
      <p class="text-emerald-200 text-sm mt-2 max-w-xl mx-auto">Dokumen persyaratan, materi tes seleksi (tulis & lisan), serta jadwal Gelombang 1 dan 2.</p>
    </div>
  </div>

  <SyaratDanJadwal />
</MainLayout>
