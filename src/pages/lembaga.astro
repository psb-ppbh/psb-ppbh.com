---
import MainLayout from '../layouts/MainLayout.astro';
import LembagaExplorer from '../components/LembagaExplorer.astro';
---

<MainLayout
  title="5 Lembaga Pendidikan Formal & Web Domain | PSB PPBH 2027/2028"
  description="Portal Pendaftaran & Domain Resmi 5 Sekolah Formal (RA, MI, MTs, MA, SMK DKV) di bawah naungan Yayasan Bidayatul Hidayah Mojogeneng."
>
  <div class="bg-emerald-950 text-white py-16 text-center">
    <div class="max-w-4xl mx-auto px-4">
      <span class="px-3.5 py-1 bg-gold-500 text-emerald-950 text-xs font-extrabold rounded-full uppercase">Parent Gateway / Induk Pintu Gerbang</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-serif text-white mt-3">5 Lembaga Sekolah Formal</h1>
      <p class="text-emerald-200 text-sm mt-2 max-w-xl mx-auto">Akses portal resmi masing-masing sekolah formal dan daftarkan putra/putri Anda dalam 1 pintu pendaftaran.</p>
    </div>
  </div>

  <LembagaExplorer />
</MainLayout>
