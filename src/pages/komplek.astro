---
import MainLayout from '../layouts/MainLayout.astro';
import KomplekExplorer from '../components/KomplekExplorer.astro';
---

<MainLayout
  title="14 Komplek Asrama Pesantren | PSB PPBH Mojogeneng 2027/2028"
  description="Eksplorasi 14 Komplek Asrama Putra dan Putri di Pondok Pesantren Bidayatul Hidayah Mojogeneng Jatirejo Mojokerto."
>
  <div class="bg-emerald-950 text-white py-16 text-center">
    <div class="max-w-4xl mx-auto px-4">
      <span class="px-3.5 py-1 bg-gold-500 text-emerald-950 text-xs font-extrabold rounded-full uppercase">Hunian Santri Berkah</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-serif text-white mt-3">14 Komplek Asrama Pesantren</h1>
      <p class="text-emerald-200 text-sm mt-2 max-w-xl mx-auto">Hunian terpisah santri putra & putri, komplek khusus Tahfidzul Qur'an 30 Juz, & pembinaan karakter salaf.</p>
    </div>
  </div>

  <KomplekExplorer />
</MainLayout>
