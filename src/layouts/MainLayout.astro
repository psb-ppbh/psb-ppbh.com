---
import { YAYASAN_INFO } from '../data/psbData';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `PSB PPBH 2027/2028 | Penerimaan Santri & Siswa Baru Pondok Pesantren Bidayatul Hidayah Mojogeneng`,
  description = `Portal Pendaftaran Terpadu 1 Pintu PSB TP. 2027/2028 Yayasan Pondok Pesantren Bidayatul Hidayah Mojogeneng Jatirejo Mojokerto. 14 Komplek Asrama & 5 Lembaga Formal (RA, MI, MTs, MA, SMK).`
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="PSB PPBH, Pendaftaran Santri Baru 2027, Bidayatul Hidayah Mojogeneng, Pesantren Mojokerto, SMK Bidayatul Hidayah, MTs Salafiyah Mojogeneng, MA Bidayatul Hidayah" />

    <!-- Google Fonts: Plus Jakarta Sans & Amiri -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1B4D3E" />
  </head>
  <body class="font-sans bg-cream-50 text-slate-800 antialiased selection:bg-emerald-800 selection:text-gold-300">
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />

    <!-- Floating WhatsApp Button -->
    <a
      href={`https://wa.me/6281252304644?text=Assalamu'alaikum%20Panitia%20PSB%20PPBH%20Mojogeneng,%20saya%20ingin%20bertanya%20informasi%20pendaftaran%20TP%202027/2028`}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 right-6 z-50 flex items-center gap-3 bg-emerald-700 hover:bg-emerald-800 text-white px-5 py-3.5 rounded-full shadow-2xl transition-all duration-300 hover:scale-105 border-2 border-gold-400 group"
      aria-label="Tanya via WhatsApp"
    >
      <div class="relative">
        <svg class="w-6 h-6 fill-current text-emerald-100 group-hover:text-gold-300 transition-colors" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span class="absolute -top-1 -right-1 flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gold-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-gold-500"></span>
        </span>
      </div>
      <div class="hidden sm:block text-left">
        <div class="text-[10px] text-emerald-200 font-medium leading-none uppercase tracking-wider">Layanan Informasi</div>
        <div class="text-xs font-bold leading-tight">Chat Panitia PSB</div>
      </div>
    </a>
  </body>
</html>
