---
---

<section id="forum" class="py-20 bg-white text-slate-800 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center space-y-4">
      <span class="inline-block px-4 py-1.5 bg-emerald-100 text-emerald-900 border border-emerald-200 rounded-full text-xs font-extrabold uppercase tracking-widest">
        Layanan Tanya Jawab Realtime
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-emerald-950 font-serif">
        Forum Q&A Terpadu PPBH
      </h2>
      <p class="text-slate-600 text-sm sm:text-base max-w-xl mx-auto">
        Tanyakan pertanyaan Anda mengenai pendaftaran, komplek asrama, maupun kurikulum. Panitia akan merespons langsung melalui aplikasi admin HP.
      </p>
      <div class="w-20 h-1.5 bg-gold-500 mx-auto rounded-full"></div>
    </div>

    <!-- Forum Box Container -->
    <div class="mt-10 bg-light-soft border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">

      <!-- Submit New Question Box -->
      <form id="forum-form" class="bg-white p-5 rounded-2xl border border-slate-200 space-y-4 shadow-sm">
        <div class="text-xs font-extrabold text-emerald-950 uppercase tracking-wider">Tanyakan Sesuatu Kepada Panitia PSB:</div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <input
            type="text"
            id="forum-nama"
            required
            placeholder="Nama Anda (Misal: Ibu Fatimah / Calon Santri)"
            class="bg-light-soft border border-slate-300 focus:border-emerald-700 rounded-xl px-4 py-2.5 text-xs text-slate-800 focus:outline-none"
          />
          <button
            type="submit"
            class="bg-emerald-900 hover:bg-emerald-950 text-white font-extrabold text-xs px-6 py-2.5 rounded-xl shadow transition-all"
          >
            Kirim Pertanyaan ✉️
          </button>
        </div>

        <textarea
          id="forum-pesan"
          required
          rows="2"
          placeholder="Tuliskan pertanyaan Anda secara singkat dan jelas..."
          class="w-full bg-light-soft border border-slate-300 focus:border-emerald-700 rounded-xl px-4 py-2.5 text-xs text-slate-800 focus:outline-none"
        ></textarea>
      </form>

      <!-- Question Feed List -->
      <div class="space-y-4 pt-2" id="forum-messages-container">
        <div class="text-center text-xs text-slate-400 py-6">Memuat forum diskusi...</div>
      </div>

    </div>

  </div>
</section>

<script>
  import { RegistrationRepository } from '../services/registrationService';

  const container = document.getElementById('forum-messages-container');
  const form = document.getElementById('forum-form') as HTMLFormElement;

  async function loadForum() {
    if (!container) return;
    const messages = await RegistrationRepository.getForumMessages();

    container.innerHTML = messages.map(msg => `
      <div class="p-4 bg-white border border-slate-200 rounded-2xl space-y-3 shadow-sm">
        <div class="flex items-center justify-between text-xs">
          <span class="font-bold text-emerald-950 flex items-center gap-1.5">
            <span>👤</span> ${msg.namaPengirim}
          </span>
          <span class="text-[10px] text-slate-400 font-mono">${msg.waktu}</span>
        </div>
        <p class="text-xs text-slate-700 leading-relaxed">${msg.pesan}</p>

        ${msg.balasan ? `
          <div class="mt-2 pt-2 border-t border-emerald-200/80 bg-emerald-50 p-3 rounded-xl text-xs space-y-1">
            <div class="font-bold text-emerald-950 flex items-center gap-1">
              <span class="text-emerald-800">💬 Balasan Panitia PSB PPBH:</span>
            </div>
            <p class="text-slate-800 leading-relaxed">${msg.balasan}</p>
          </div>
        ` : `
          <div class="text-[10px] text-amber-700 italic">Menunggu balasan panitia via psb-app...</div>
        `}
      </div>
    `).join('');
  }

  loadForum();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nama = (document.getElementById('forum-nama') as HTMLInputElement).value;
    const pesan = (document.getElementById('forum-pesan') as HTMLTextAreaElement).value;

    await RegistrationRepository.sendForumQuestion(nama, pesan);
    (document.getElementById('forum-pesan') as HTMLTextAreaElement).value = '';
    alert('Pertanyaan Anda telah terkirim ke panitia!');
    loadForum();
  });
</script>
