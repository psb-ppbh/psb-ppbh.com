---
import { LEMBAGA_FORMAL, KOMPLEK_ASRAMA, YAYASAN_INFO } from '../data/psbData';
---

<section id="daftar" class="py-16 sm:py-20 bg-gradient-to-b from-white via-emerald-50/50 to-light-bg text-slate-800 relative overflow-hidden">

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pb-12 sm:pb-0">

    <!-- Section Header -->
    <div class="text-center space-y-3 printable-hide">
      <span class="inline-block px-4 py-1.5 bg-emerald-100 text-emerald-900 border border-emerald-200 rounded-full text-xs font-extrabold uppercase tracking-widest">
        Formulir Online PSB TP. {YAYASAN_INFO.tahunAjaran}
      </span>
      <h2 class="text-2xl sm:text-5xl font-extrabold text-emerald-950 font-serif">
        Pendaftaran Terpadu 1 Pintu Akses
      </h2>
      <p class="text-slate-600 text-xs sm:text-base max-w-xl mx-auto">
        Isi formulir pendaftaran secara online untuk mendapatkan Kartu Pendaftaran Digital dan Akses Grup WA Resmi Calon Wali Santri.
      </p>
      <div class="w-16 h-1 bg-gold-500 mx-auto rounded-full"></div>
    </div>

    <!-- Mobile-Optimized Step Progress Indicator -->
    <div class="mt-8 sm:mt-10 flex items-center justify-center gap-2 sm:gap-4 text-[11px] sm:text-xs font-extrabold printable-hide" id="step-indicator">
      <div class="step-badge step-1 flex items-center gap-1.5 sm:gap-2 text-emerald-900">
        <span class="w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-emerald-900 text-gold-300 flex items-center justify-center font-extrabold shadow-md shrink-0">1</span>
        <span>Quick Lead</span>
      </div>
      <div class="w-6 sm:w-12 h-0.5 bg-slate-300"></div>
      <div class="step-badge step-2 flex items-center gap-1.5 sm:gap-2 text-slate-400 opacity-60">
        <span class="w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-extrabold shrink-0">2</span>
        <span>Detail Data</span>
      </div>
      <div class="w-6 sm:w-12 h-0.5 bg-slate-300"></div>
      <div class="step-badge step-3 flex items-center gap-1.5 sm:gap-2 text-slate-400 opacity-60">
        <span class="w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-extrabold shrink-0">3</span>
        <span>Kartu Digital</span>
      </div>
    </div>

    <!-- Main Multi-step Form Card -->
    <div class="mt-8 bg-white border border-slate-200 rounded-[2rem] p-5 sm:p-10 shadow-xl relative mb-8 printable-container">

      <!-- STEP 1: Quick Lead Capture -->
      <form id="form-step-1" class="space-y-5 sm:space-y-6 printable-hide">
        <div class="border-b border-slate-100 pb-3 sm:pb-4">
          <h3 class="text-lg sm:text-xl font-bold font-serif text-emerald-950">Tahap 1: Informasi Kontak Utama</h3>
          <p class="text-xs text-slate-500 mt-1">Isi data minimal di bawah ini agar kontak Anda langsung tersimpan di sistem PSB PPBH.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <div class="space-y-1.5 sm:space-y-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Nama Lengkap Calon Santri / Siswa *</label>
            <input
              type="text"
              id="namaLengkap"
              required
              placeholder="Contoh: Muhammad Bahrul Ulum"
              class="w-full bg-light-soft border border-slate-300 focus:border-emerald-700 rounded-2xl px-4 py-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            />
          </div>

          <div class="space-y-1.5 sm:space-y-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Nomor WhatsApp Aktif Wali *</label>
            <input
              type="tel"
              id="nomorWa"
              required
              placeholder="Contoh: 081234567890"
              class="w-full bg-light-soft border border-slate-300 focus:border-emerald-700 rounded-2xl px-4 py-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <div class="space-y-1.5 sm:space-y-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Pilihan Lembaga Formal *</label>
            <select
              id="lembagaPilihan"
              required
              class="w-full bg-light-soft border border-slate-300 focus:border-emerald-700 rounded-2xl px-4 py-3 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            >
              <option value="">-- Pilih Jenjang Sekolah --</option>
              {LEMBAGA_FORMAL.map(lembaga => (
                <option value={lembaga.nama}>{lembaga.jenjang} - {lembaga.nama}</option>
              ))}
            </select>
          </div>

          <div class="space-y-1.5 sm:space-y-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Pilihan Komplek Asrama *</label>
            <select
              id="komplekPilihan"
              required
              class="w-full bg-light-soft border border-slate-300 focus:border-emerald-700 rounded-2xl px-4 py-3 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            >
              <option value="">-- Pilih Komplek Asrama --</option>
              {KOMPLEK_ASRAMA.map(komplek => (
                <option value={komplek.nama}>#{komplek.id} {komplek.nama} ({komplek.kategori})</option>
              ))}
            </select>
          </div>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-[11px] text-slate-500 font-medium text-center sm:text-left">
            ✓ Biaya pendaftaran Rp 200.000 (Dapat dibayar via kantor/transfer)
          </div>
          <button
            type="submit"
            class="w-full sm:w-auto bg-emerald-900 hover:bg-emerald-950 text-white font-extrabold text-xs sm:text-sm px-8 py-3.5 rounded-2xl shadow-lg hover:shadow-emerald-900/20 transition-all border border-gold-400/30"
          >
            Lanjut Tahap 2 & Simpan Lead ➔
          </button>
        </div>
      </form>

      <!-- STEP 2: Detail Data -->
      <form id="form-step-2" class="hidden space-y-5 sm:space-y-6 printable-hide">
        <div class="border-b border-slate-100 pb-3 sm:pb-4 flex items-center justify-between">
          <div>
            <h3 class="text-lg sm:text-xl font-bold font-serif text-emerald-950">Tahap 2: Pengisian Data Berkas (KK/KTP)</h3>
            <p class="text-xs text-slate-500 mt-1">ID Pendaftaran sementara: <span id="temp-id-display" class="font-mono font-bold text-emerald-900">PPBH-2027-XXXX</span></p>
          </div>
          <button type="button" id="btn-back-step1" class="text-xs text-emerald-800 font-bold hover:underline">
            ← Kembali ke Step 1
          </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <div class="space-y-1.5 sm:space-y-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">NIK Calon Santri (Sesuai KK)</label>
            <input
              type="text"
              id="nik"
              placeholder="16 Digit NIK"
              class="w-full bg-light-soft border border-slate-300 focus:border-emerald-700 rounded-2xl px-4 py-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none"
            />
          </div>

          <div class="space-y-1.5 sm:space-y-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Nomor Kartu Keluarga (KK)</label>
            <input
              type="text"
              id="nokk"
              placeholder="16 Digit Nomor KK"
              class="w-full bg-light-soft border border-slate-300 focus:border-emerald-700 rounded-2xl px-4 py-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <div class="space-y-1.5 sm:space-y-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Nama Wali / Orang Tua</label>
            <input
              type="text"
              id="namaOrangTua"
              placeholder="Nama Ayah / Ibu Kandung"
              class="w-full bg-light-soft border border-slate-300 focus:border-emerald-700 rounded-2xl px-4 py-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none"
            />
          </div>

          <div class="space-y-1.5 sm:space-y-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Sekolah / Asal Pendidikan</label>
            <input
              type="text"
              id="sekolahAsal"
              placeholder="Contoh: MI Salafiyah / SD Negeri 1 Mojokerto"
              class="w-full bg-light-soft border border-slate-300 focus:border-emerald-700 rounded-2xl px-4 py-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none"
            />
          </div>
        </div>

        <div class="space-y-1.5 sm:space-y-2">
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Alamat Lengkap (Kabupaten / Kota)</label>
          <textarea
            id="alamatLengkap"
            rows="2"
            placeholder="Dusun, Desa, Kecamatan, Kabupaten/Kota, Provinsi"
            class="w-full bg-light-soft border border-slate-300 focus:border-emerald-700 rounded-2xl px-4 py-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none"
          ></textarea>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4">
          <span class="text-xs text-slate-500 font-medium text-center sm:text-left">Formulir online resmi Yayasan Ponpes Bidayatul Hidayah</span>
          <button
            type="submit"
            class="w-full sm:w-auto bg-emerald-900 hover:bg-emerald-950 text-white font-extrabold text-xs sm:text-sm px-8 py-3.5 rounded-2xl shadow-lg hover:shadow-emerald-900/20 transition-all border border-gold-400/30"
          >
            Selesaikan & Cetak Kartu Digital 🎯
          </button>
        </div>
      </form>

      <!-- STEP 3: Digital Pass Card -->
      <div id="form-step-3" class="hidden space-y-6">
        <div class="text-center space-y-2 printable-hide">
          <div class="inline-flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-emerald-900 text-gold-300 font-bold text-2xl sm:text-3xl shadow-lg">
            ✓
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold font-serif text-emerald-950">Pendaftaran Berhasil!</h3>
          <p class="text-xs sm:text-sm text-slate-600">Selamat, pendaftaran Anda di Yayasan Ponpes Bidayatul Hidayah telah tercatat dalam sistem.</p>
        </div>

        <!-- Official Digital Pass Card (Printed Only) -->
        <div id="digital-card-print" class="bg-gradient-to-br from-emerald-950 via-emerald-900 to-emerald-950 border-2 border-gold-400/80 rounded-3xl p-5 sm:p-6 shadow-2xl relative overflow-hidden max-w-lg mx-auto space-y-4 text-white">
          <div class="flex items-center justify-between border-b border-emerald-800 pb-3">
            <div class="flex items-center gap-3">
              <img src={YAYASAN_INFO.logoUrl} alt="Logo" class="w-9 h-9 sm:w-10 sm:h-10 object-contain" />
              <div>
                <div class="text-[9px] sm:text-[10px] text-gold-400 font-extrabold uppercase tracking-widest">KARTU PENDAFTARAN DIGITAL</div>
                <div class="text-xs sm:text-sm font-extrabold text-white">PSB PPBH TP. {YAYASAN_INFO.tahunAjaran}</div>
              </div>
            </div>
            <div class="bg-gold-500 text-emerald-950 px-2.5 py-1 rounded-xl font-mono font-bold text-xs shadow-sm" id="card-id">
              PPBH-875143
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 text-xs">
            <div>
              <span class="text-emerald-400 block text-[9px] uppercase font-bold">NAMA SANTRI:</span>
              <span class="font-bold text-white text-xs sm:text-sm" id="card-nama">ahmad fatoni</span>
            </div>
            <div>
              <span class="text-emerald-400 block text-[9px] uppercase font-bold">NO. WHATSAPP WALI:</span>
              <span class="font-bold text-white" id="card-wa">0812345679</span>
            </div>
            <div>
              <span class="text-emerald-400 block text-[9px] uppercase font-bold">LEMBAGA FORMAL:</span>
              <span class="font-bold text-gold-300" id="card-lembaga">MTs Salafiyah Bidayatul Hidayah</span>
            </div>
            <div>
              <span class="text-emerald-400 block text-[9px] uppercase font-bold">KOMPLEK ASRAMA:</span>
              <span class="font-bold text-gold-300" id="card-komplek">Asrama Al Qurthuby Putra</span>
            </div>
          </div>

          <div class="pt-3 border-t border-emerald-800 flex items-center justify-between text-[10px] sm:text-[11px] text-emerald-200">
            <div>
              <span class="font-bold text-white">Mojogeneng, Jatirejo, Mojokerto</span>
              <div class="text-[9px] text-emerald-300">Tunjukkan kartu ini saat verifikasi tes seleksi</div>
            </div>
            <!-- Dynamic Dynamic Verification QR Code Image -->
            <div class="bg-white p-1 rounded-xl border border-gold-400 shadow-sm shrink-0">
              <img
                id="card-qr-img"
                src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://psb-ppbh-com.pages.dev/verify?id=PPBH-875143"
                alt="QR Verifikasi Official"
                class="w-12 h-12 object-contain"
              />
            </div>
          </div>
        </div>

        <!-- Action Links -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 pt-4 printable-hide">
          <a
            id="link-wa-panitia"
            href="#"
            target="_blank"
            class="w-full sm:w-auto bg-emerald-800 hover:bg-emerald-900 text-white font-bold text-xs sm:text-sm px-6 py-3.5 rounded-2xl transition-all text-center flex items-center justify-center gap-2 border border-gold-400/40 shadow-md"
          >
            <span>💬 Konfirmasi via WA Panitia</span>
          </a>
          <button
            onclick="window.print()"
            class="w-full sm:w-auto bg-gold-400 hover:bg-gold-500 text-emerald-950 font-extrabold text-xs sm:text-sm px-6 py-3.5 rounded-2xl transition-all text-center shadow-md"
          >
            🖨️ Cetak / Simpan Kartu PDF
          </button>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  /* Print Optimization: Hide everything EXCEPT the Digital Pass Card during window.print() */
  @media print {
    body * {
      visibility: hidden !important;
    }
    header, footer, nav, .printable-hide, #btn-scroll-top, .fixed {
      display: none !important;
    }
    #daftar, .printable-container, #form-step-3, #digital-card-print, #digital-card-print * {
      visibility: visible !important;
    }
    #digital-card-print {
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      width: 100% !important;
      max-width: 500px !important;
      border: 3px solid #D4AF37 !important;
      box-shadow: none !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
  }
</style>

<script>
  import { RegistrationRepository } from '../services/registrationService';

  let currentLeadId = '';

  const step1Form = document.getElementById('form-step-1') as HTMLFormElement;
  const step2Form = document.getElementById('form-step-2') as HTMLFormElement;
  const step3Container = document.getElementById('form-step-3') as HTMLDivElement;
  const btnBackStep1 = document.getElementById('btn-back-step1');

  step1Form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const nama = (document.getElementById('namaLengkap') as HTMLInputElement).value;
    const wa = (document.getElementById('nomorWa') as HTMLInputElement).value;
    const lembaga = (document.getElementById('lembagaPilihan') as HTMLSelectElement).value;
    const komplek = (document.getElementById('komplekPilihan') as HTMLSelectElement).value;

    const res = await RegistrationRepository.submitQuickLead({
      namaLengkap: nama,
      nomorWa: wa,
      lembagaPilihan: lembaga,
      komplekPilihan: komplek
    });

    currentLeadId = res.id;
    (document.getElementById('temp-id-display') as HTMLElement).innerText = currentLeadId;

    step1Form.classList.add('hidden');
    step2Form.classList.remove('hidden');

    document.querySelector('.step-2')?.classList.remove('opacity-60');
    document.querySelector('.step-2')?.classList.add('text-emerald-900');
  });

  btnBackStep1?.addEventListener('click', () => {
    step2Form.classList.add('hidden');
    step1Form.classList.remove('hidden');
  });

  step2Form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const nama = (document.getElementById('namaLengkap') as HTMLInputElement).value;
    const wa = (document.getElementById('nomorWa') as HTMLInputElement).value;
    const lembaga = (document.getElementById('lembagaPilihan') as HTMLSelectElement).value;
    const komplek = (document.getElementById('komplekPilihan') as HTMLSelectElement).value;

    const nik = (document.getElementById('nik') as HTMLInputElement).value;
    const nokk = (document.getElementById('nokk') as HTMLInputElement).value;
    const ortu = (document.getElementById('namaOrangTua') as HTMLInputElement).value;
    const sekolah = (document.getElementById('sekolahAsal') as HTMLInputElement).value;
    const alamat = (document.getElementById('alamatLengkap') as HTMLTextAreaElement).value;

    await RegistrationRepository.submitCompleteData({
      id: currentLeadId,
      namaLengkap: nama,
      nomorWa: wa,
      lembagaPilihan: lembaga,
      komplekPilihan: komplek,
      nik,
      nokk,
      namaOrangTua: ortu,
      sekolahAsal: sekolah,
      alamatLengkap: alamat
    });

    (document.getElementById('card-id') as HTMLElement).innerText = currentLeadId;
    (document.getElementById('card-nama') as HTMLElement).innerText = nama;
    (document.getElementById('card-wa') as HTMLElement).innerText = wa;
    (document.getElementById('card-lembaga') as HTMLElement).innerText = lembaga;
    (document.getElementById('card-komplek') as HTMLElement).innerText = komplek;

    // Set Live QR Code URL for panitia scanner
    const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent('https://psb-ppbh-com.pages.dev/verify?id=' + currentLeadId)}`;
    (document.getElementById('card-qr-img') as HTMLImageElement).src = qrUrl;

    const waText = encodeURIComponent(`Assalamu'alaikum Panitia PSB PPBH, saya telah mendaftar online.\n*ID Pendaftaran:* ${currentLeadId}\n*Nama:* ${nama}\n*Lembaga:* ${lembaga}\n*Komplek:* ${komplek}`);
    (document.getElementById('link-wa-panitia') as HTMLAnchorElement).href = `https://wa.me/6281252304644?text=${waText}`;

    step2Form.classList.add('hidden');
    step3Container.classList.remove('hidden');

    document.querySelector('.step-3')?.classList.remove('opacity-60');
    document.querySelector('.step-3')?.classList.add('text-emerald-900');
  });
</script>
