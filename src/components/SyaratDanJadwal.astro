---
import { SYARAT_PENDAFTARAN, JADWAL_SELEKSI, MATERI_TES, YAYASAN_INFO } from '../data/psbData';
---

<section id="syarat" class="py-20 bg-cream-100 text-slate-800 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block px-4 py-1.5 bg-emerald-800/10 text-emerald-800 rounded-full text-xs font-extrabold uppercase tracking-widest">
        Panduan PSB TP. {YAYASAN_INFO.tahunAjaran}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-emerald-950 font-serif">
        Syarat Pendaftaran & Alur Seleksi
      </h2>
      <p class="text-slate-600 text-sm sm:text-base">
        Informasi lengkap persyaratan dokumen, materi tes seleksi, dan jadwal gelombang pendaftaran TP 2027/2028.
      </p>
      <div class="w-20 h-1.5 bg-gold-500 mx-auto rounded-full"></div>
    </div>

    <div class="mt-14 grid grid-cols-1 lg:grid-cols-12 gap-8">

      <!-- Syarat & Materi Tes -->
      <div class="lg:col-span-6 space-y-8">

        <!-- Syarat Box -->
        <div class="bg-white p-8 rounded-3xl border border-sage-200 shadow-md">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-xl">📝</div>
            <div>
              <h3 class="text-xl font-bold text-emerald-950 font-serif">Syarat Pendaftaran</h3>
              <p class="text-xs text-slate-500">Biaya Pendaftaran {YAYASAN_INFO.biayaPendaftaran}</p>
            </div>
          </div>

          <div class="space-y-3">
            {SYARAT_PENDAFTARAN.map((syarat, idx) => (
              <div class="flex items-start gap-3 text-xs sm:text-sm text-slate-700 bg-slate-50 p-3.5 rounded-xl border border-slate-100">
                <span class="w-5 h-5 rounded-full bg-emerald-800 text-white font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">
                  {idx + 1}
                </span>
                <span>{syarat}</span>
              </div>
            ))}
          </div>

          <div class="mt-6 p-4 bg-amber-50 border border-amber-200 rounded-2xl text-xs text-amber-900 space-y-1">
            <div class="font-bold flex items-center gap-1.5 text-amber-950">
              <span>⚠️ Catatan Ketentuan Tes:</span>
            </div>
            <ul class="list-disc list-inside space-y-1 text-slate-700">
              {MATERI_TES.ketentuan.map(k => (
                <li>{k}</li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Materi Tes Card -->
        <div class="bg-gradient-to-br from-emerald-900 to-emerald-950 text-white p-8 rounded-3xl shadow-xl border border-gold-400/40">
          <h3 class="text-xl font-bold font-serif text-gold-300 mb-6 flex items-center gap-2">
            <span>🎯</span> Materi Tes Seleksi (Tulis & Lisan)
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Tes Tulis -->
            <div class="bg-emerald-900/80 p-5 rounded-2xl border border-emerald-700 space-y-2">
              <div class="inline-block px-3 py-1 bg-amber-500 text-emerald-950 text-xs font-extrabold rounded-lg">
                Tes Tulis
              </div>
              <ul class="space-y-1.5 text-xs text-emerald-100 pt-1">
                {MATERI_TES.tulis.map(m => (
                  <li class="flex items-center gap-2">
                    <span class="text-gold-400">✓</span> {m}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Tes Lisan -->
            <div class="bg-emerald-900/80 p-5 rounded-2xl border border-emerald-700 space-y-2">
              <div class="inline-block px-3 py-1 bg-purple-500 text-white text-xs font-extrabold rounded-lg">
                Tes Lisan
              </div>
              <ul class="space-y-1.5 text-xs text-emerald-100 pt-1">
                {MATERI_TES.lisan.map(m => (
                  <li class="flex items-center gap-2">
                    <span class="text-gold-400">✓</span> {m}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

      </div>

      <!-- Jadwal Gelombang Timeline -->
      <div class="lg:col-span-6 space-y-8">

        <div class="bg-white p-8 rounded-3xl border border-sage-200 shadow-md">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-gold-100 text-gold-700 flex items-center justify-center font-bold text-xl">📅</div>
            <div>
              <h3 class="text-xl font-bold text-emerald-950 font-serif">Jadwal Seleksi TP. 2027/2028</h3>
              <p class="text-xs text-slate-500">Pendaftaran Dibuka 01 Maret 2027</p>
            </div>
          </div>

          <div class="space-y-6">
            {JADWAL_SELEKSI.map(jadwal => (
              <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 space-y-4">

                <div class="flex items-center justify-between border-b border-slate-200 pb-3">
                  <span class="text-base font-extrabold text-emerald-900 font-serif">
                    {jadwal.lembaga}
                  </span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800">
                    2 Gelombang
                  </span>
                </div>

                <!-- Gelombang 1 -->
                <div class="space-y-2">
                  <div class="flex items-center justify-between text-xs font-bold text-emerald-800">
                    <span>Gelombang 1</span>
                    <span>{jadwal.gelombang1.pendaftaran}</span>
                  </div>
                  <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-600">
                    <div class="bg-white p-2 rounded-lg border border-slate-200">
                      <strong>Tes:</strong> {jadwal.gelombang1.tes}
                    </div>
                    <div class="bg-white p-2 rounded-lg border border-slate-200">
                      <strong>Pengumuman:</strong> {jadwal.gelombang1.pengumuman}
                    </div>
                  </div>
                </div>

                <!-- Gelombang 2 -->
                <div class="space-y-2 pt-2 border-t border-dashed border-slate-200">
                  <div class="flex items-center justify-between text-xs font-bold text-amber-800">
                    <span>Gelombang 2</span>
                    <span>{jadwal.gelombang2.pendaftaran}</span>
                  </div>
                  <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-600">
                    <div class="bg-white p-2 rounded-lg border border-slate-200">
                      <strong>Tes:</strong> {jadwal.gelombang2.tes}
                    </div>
                    <div class="bg-white p-2 rounded-lg border border-slate-200">
                      <strong>Pengumuman:</strong> {jadwal.gelombang2.pengumuman}
                    </div>
                  </div>
                </div>

              </div>
            ))}
          </div>

          <!-- Wajib Daftar Ulang Statement -->
          <div class="mt-6 p-4 bg-emerald-950 text-white rounded-2xl text-xs space-y-1 leading-relaxed">
            <div class="font-bold text-gold-300">📌 Ketentuan Wajib Daftar Ulang:</div>
            <p class="text-emerald-100">
              Bagi Calon Siswa/Santri yang mendaftar dan dinyatakan <strong>LOLOS Tes Seleksi</strong>, WAJIB MENGIKUTI seluruh program Ponpes Bidayatul Hidayah dan menyelesaikan proses <strong>DAFTAR ULANG</strong>. Jika tidak, maka dinyatakan mengundurkan diri.
            </p>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
