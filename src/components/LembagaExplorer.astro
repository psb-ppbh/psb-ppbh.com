---
import { LEMBAGA_FORMAL } from '../data/psbData';
---

<section id="lembaga" class="py-20 bg-emerald-950 text-white relative overflow-hidden">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block px-4 py-1.5 bg-gold-500/20 text-gold-300 border border-gold-400/30 rounded-full text-xs font-extrabold uppercase tracking-widest">
        Pendidikan Formal Integrated
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-serif">
        5 Jenjang Lembaga Pendidikan Formal
      </h2>
      <p class="text-emerald-200 text-sm sm:text-base">
        Terakreditasi resmi, mengintegrasikan kurikulum kementerian nasional dengan keunggulan keilmuan pesantren salafiyah.
      </p>
      <div class="w-20 h-1.5 bg-gold-400 mx-auto rounded-full"></div>
    </div>

    <!-- Cards Grid -->
    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {LEMBAGA_FORMAL.map(lembaga => (
        <div class="bg-emerald-900/80 border border-emerald-700/80 rounded-3xl p-6 sm:p-8 flex flex-col justify-between hover:border-gold-400/60 transition-all duration-300 hover:-translate-y-1 shadow-xl group">

          <div class="space-y-4">
            <!-- Jenjang Badge -->
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 bg-gold-400 text-emerald-950 text-xs font-extrabold rounded-xl uppercase tracking-wider">
                {lembaga.jenjang}
              </span>
              <span class="text-2xl group-hover:scale-110 transition-transform">
                {lembaga.id === 'ra' ? '👶' : lembaga.id === 'mi' ? '📚' : lembaga.id === 'mts' ? '🎓' : lembaga.id === 'ma' ? '🏛️' : '💻'}
              </span>
            </div>

            <!-- Nama Sekolah -->
            <h3 class="text-xl font-bold text-white font-serif group-hover:text-gold-300 transition-colors">
              {lembaga.nama}
            </h3>

            <!-- Deskripsi -->
            <p class="text-xs sm:text-sm text-emerald-200 leading-relaxed">
              {lembaga.deskripsi}
            </p>

            <!-- Jurusan jika SMK -->
            {lembaga.jurusan && (
              <div class="pt-2">
                <div class="text-[11px] font-bold text-gold-400 uppercase tracking-wider mb-2">Konsentrasi Keahlian / Jurusan:</div>
                <div class="space-y-1.5">
                  {lembaga.jurusan.map(j => (
                    <div class="text-xs bg-emerald-950 p-2 rounded-xl border border-emerald-700 text-emerald-100 flex items-center gap-2">
                      <span class="text-gold-400">⚡</span>
                      <span>{j}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Kepala Sekolah Footer -->
          {lembaga.kepalaSekolah && (
            <div class="mt-6 pt-4 border-t border-emerald-800 flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-emerald-800 border border-gold-400/40 flex items-center justify-center text-xs font-bold text-gold-300">
                KS
              </div>
              <div>
                <div class="text-[10px] text-emerald-300 uppercase tracking-wider">Kepala Sekolah</div>
                <div class="text-xs font-bold text-white">{lembaga.kepalaSekolah}</div>
              </div>
            </div>
          )}

        </div>
      ))}
    </div>

    <!-- Quick Callout -->
    <div class="mt-12 bg-gradient-to-r from-emerald-900 to-emerald-950 border-2 border-gold-400/40 p-6 sm:p-8 rounded-3xl flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center sm:text-left">
        <h4 class="text-lg font-bold text-gold-300 font-serif">Pendaftaran Terpadu 1 Akses</h4>
        <p class="text-xs sm:text-sm text-emerald-200">Seluruh jenjang formal terkoneksi langsung dengan pilihan 14 Komplek Asrama PPBH Mojogeneng.</p>
      </div>
      <a
        href="#daftar"
        class="bg-gold-400 hover:bg-gold-500 text-emerald-950 font-extrabold text-sm px-6 py-3 rounded-2xl transition-all whitespace-nowrap shadow-lg"
      >
        Pilih Lembaga & Daftar
      </a>
    </div>

  </div>
</section>
