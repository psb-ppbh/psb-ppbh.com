---
---

<header class="sticky top-0 z-40 bg-emerald-900/95 backdrop-blur-md border-b border-emerald-800 text-white shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <!-- Brand & Logo -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-gold-400 to-gold-600 p-0.5 shadow-md group-hover:scale-105 transition-transform">
          <div class="w-full h-full bg-emerald-950 rounded-[14px] flex items-center justify-center overflow-hidden">
            <span class="text-xl font-bold font-arabic text-gold-400">BH</span>
          </div>
        </div>
        <div>
          <div class="text-xs font-semibold text-gold-400 tracking-wider uppercase">Yayasan Ponpes</div>
          <div class="text-base font-extrabold tracking-tight text-white group-hover:text-gold-300 transition-colors">
            Bidayatul Hidayah
          </div>
          <div class="text-[10px] text-emerald-200">Mojogeneng - Jatirejo - Mojokerto</div>
        </div>
      </a>

      <!-- Desktop Nav Menu -->
      <nav class="hidden lg:flex items-center gap-7 text-sm font-medium">
        <a href="#profil" class="text-emerald-100 hover:text-gold-300 transition-colors">Profil</a>
        <a href="#lembaga" class="text-emerald-100 hover:text-gold-300 transition-colors">5 Lembaga</a>
        <a href="#komplek" class="text-emerald-100 hover:text-gold-300 transition-colors">14 Komplek</a>
        <a href="#syarat" class="text-emerald-100 hover:text-gold-300 transition-colors">Syarat & Alur</a>
        <a href="#forum" class="text-emerald-100 hover:text-gold-300 transition-colors flex items-center gap-1.5">
          <span>Forum Q&A</span>
          <span class="bg-gold-500 text-emerald-950 text-[10px] font-bold px-1.5 py-0.5 rounded-full">Live</span>
        </a>
      </nav>

      <!-- Action Button -->
      <div class="hidden sm:flex items-center gap-4">
        <a
          href="#daftar"
          class="bg-gradient-to-r from-gold-400 to-gold-500 hover:from-gold-500 hover:to-gold-600 text-emerald-950 font-bold text-sm px-5 py-2.5 rounded-xl shadow-md hover:shadow-gold-500/20 transition-all hover:-translate-y-0.5"
        >
          Daftar PSB 2027/2028
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-lg text-emerald-200 hover:text-white hover:bg-emerald-800 focus:outline-none"
        aria-label="Toggle Menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-emerald-950 border-b border-emerald-800 px-4 pt-2 pb-6 space-y-3">
    <a href="#profil" class="block text-emerald-100 hover:text-gold-300 py-2">Profil Pesantren</a>
    <a href="#lembaga" class="block text-emerald-100 hover:text-gold-300 py-2">5 Lembaga Formal</a>
    <a href="#komplek" class="block text-emerald-100 hover:text-gold-300 py-2">14 Komplek Asrama</a>
    <a href="#syarat" class="block text-emerald-100 hover:text-gold-300 py-2">Syarat & Alur Pendaftaran</a>
    <a href="#forum" class="block text-emerald-100 hover:text-gold-300 py-2">Forum Diskusi Q&A</a>
    <a href="#daftar" class="block bg-gold-400 text-emerald-950 text-center font-bold py-3 rounded-xl mt-4">Daftar PSB 2027/2028 Sekarang</a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>
