---
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-emerald-100 text-slate-800 shadow-sm transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <!-- Official Logo & Brand Redaksi Specific Header -->
      <a href="#" class="flex items-center gap-3.5 group">
        <div class="relative w-12 h-12 flex items-center justify-center p-1 bg-gradient-to-br from-emerald-50 to-emerald-100 rounded-2xl border border-emerald-200 shadow-sm group-hover:scale-105 transition-transform shrink-0">
          <img src="/logo-ppbh.png" alt="Logo PPBH" class="w-full h-full object-contain" />
        </div>
        <div>
          <div class="text-[10px] font-extrabold text-gold-600 tracking-wider uppercase leading-snug">Yayasan Ponpes Bidayatul Hidayah</div>
          <div class="text-base sm:text-lg font-extrabold tracking-tight text-emerald-950 group-hover:text-emerald-800 transition-colors font-serif leading-tight">
            PSB-PPBH
          </div>
          <div class="text-[10px] text-slate-500 font-medium leading-snug">Mojogeneng - Jatirejo - Mojokerto</div>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center gap-7 text-sm font-semibold text-slate-700">
        <a href="#profil" class="hover:text-emerald-900 transition-colors">Profil</a>
        <a href="#linimasa" class="hover:text-emerald-900 transition-colors">Lini Masa (1948)</a>
        <a href="#lembaga" class="hover:text-emerald-900 transition-colors">5 Lembaga</a>
        <a href="#komplek" class="hover:text-emerald-900 transition-colors">14 Komplek</a>
        <a href="#syarat" class="hover:text-emerald-900 transition-colors">Syarat & Alur</a>
        <a href="#artikel" class="hover:text-emerald-900 transition-colors">Warta Artikel</a>
        <a href="#forum" class="hover:text-emerald-900 transition-colors flex items-center gap-1.5">
          <span>Forum Q&A</span>
          <span class="bg-emerald-900 text-gold-300 text-[10px] font-extrabold px-2 py-0.5 rounded-full shadow-sm">Live</span>
        </a>
      </nav>

      <!-- CTA Button -->
      <div class="hidden sm:flex items-center gap-4">
        <a
          href="#daftar"
          class="bg-gradient-to-r from-emerald-900 via-emerald-800 to-emerald-900 hover:from-emerald-950 hover:to-emerald-900 text-white font-extrabold text-sm px-6 py-3 rounded-2xl shadow-md hover:shadow-emerald-900/20 transition-all hover:-translate-y-0.5 border border-gold-400/30 flex items-center gap-2"
        >
          <span>Daftar PSB 2027/2028</span>
          <span class="text-gold-400">➔</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2.5 rounded-xl text-emerald-900 hover:bg-emerald-50 focus:outline-none border border-emerald-200"
        aria-label="Toggle Menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Running Text / Marquee Bar Below Header -->
  <div class="bg-emerald-950 text-white text-xs py-2 px-4 border-t border-emerald-800 flex items-center overflow-hidden shadow-inner">
    <div class="bg-gold-500 text-emerald-950 px-2.5 py-0.5 rounded-md font-extrabold text-[10px] tracking-widest uppercase shrink-0 mr-3 shadow-sm flex items-center gap-1">
      <span>📢</span> <span>PESAN PANITIA</span>
    </div>
    <div class="overflow-hidden whitespace-nowrap relative w-full">
      <div class="inline-block animate-marquee text-emerald-100 font-medium tracking-wide">
        Mondok ngak bakal nyita waktumu di dunia, Mondok banyak tutorial hidup di dunia & akhirat yang bisa kamu warisi. - Di Mojogeneng kamu ditempa menjadi pewaris yang berakhlakul karimah - Kanjeng Nabi MUHAMMAD SAW. Sang Maestro tutorial telah mewariskan semuanya - Admin hanya mengingatkan buruan daftar sebelum pendaftaran ditutup
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-emerald-100 px-6 pt-2 pb-6 space-y-3 shadow-lg">
    <a href="#profil" class="block text-slate-800 hover:text-emerald-900 font-semibold py-2">Profil Pesantren</a>
    <a href="#linimasa" class="block text-slate-800 hover:text-emerald-900 font-semibold py-2">Lini Masa History (1948)</a>
    <a href="#lembaga" class="block text-slate-800 hover:text-emerald-900 font-semibold py-2">5 Lembaga Formal</a>
    <a href="#komplek" class="block text-slate-800 hover:text-emerald-900 font-semibold py-2">14 Komplek Asrama</a>
    <a href="#syarat" class="block text-slate-800 hover:text-emerald-900 font-semibold py-2">Syarat & Alur Pendaftaran</a>
    <a href="#artikel" class="block text-slate-800 hover:text-emerald-900 font-semibold py-2">Warta & Artikel Pesantren</a>
    <a href="#forum" class="block text-slate-800 hover:text-emerald-900 font-semibold py-2">Forum Diskusi Q&A</a>
    <a href="#daftar" class="block bg-emerald-900 text-white text-center font-bold py-3.5 rounded-2xl mt-4 border border-gold-400/40">Daftar PSB 2027/2028 Sekarang</a>
  </div>
</header>

<style>
  @keyframes marquee {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-100%); }
  }
  .animate-marquee {
    display: inline-block;
    padding-left: 100%;
    animation: marquee 35s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>
