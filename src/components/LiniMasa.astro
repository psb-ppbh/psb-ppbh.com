---
import { LINI_MASA_HISTORY } from '../data/psbData';
---

<section id="linimasa" class="py-20 bg-light-soft text-slate-800 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block px-4 py-1.5 bg-emerald-100 text-emerald-900 border border-emerald-200 rounded-full text-xs font-extrabold uppercase tracking-widest">
        Jejak Langkah Keilmuan
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-emerald-950 font-serif">
        Lini Masa Perjalanan PPBH (1948 - Sekarang)
      </h2>
      <p class="text-slate-600 text-sm sm:text-base">
        Kilas balik pertumbuhan Pesantren Bidayatul Hidayah Mojogeneng dari masa ke masa dalam mencetak generasi Rabbani.
      </p>
      <div class="w-20 h-1.5 bg-gold-500 mx-auto rounded-full"></div>
    </div>

    <!-- Timeline List -->
    <div class="mt-16 relative">
      <!-- Center Vertical Line -->
      <div class="hidden sm:block absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-1 bg-emerald-200 rounded-full"></div>

      <div class="space-y-12">
        {LINI_MASA_HISTORY.map((item, idx) => (
          <div class={`flex flex-col sm:flex-row items-center justify-between gap-8 ${
            idx % 2 === 0 ? 'sm:flex-row-reverse' : ''
          }`}>

            <!-- Content Box -->
            <div class="w-full sm:w-[45%] bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-md space-y-3 hover:border-emerald-700 transition-all">
              <div class="flex items-center justify-between">
                <span class="text-2xl font-extrabold text-emerald-900 font-serif">{item.tahun}</span>
                {item.badge && (
                  <span class="px-3 py-1 bg-gold-400 text-emerald-950 text-[10px] font-extrabold rounded-full uppercase tracking-wider">
                    {item.badge}
                  </span>
                )}
              </div>
              <h3 class="text-lg font-bold text-slate-800 font-serif">{item.judul}</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.deskripsi}</p>
            </div>

            <!-- Center Timeline Point -->
            <div class="w-10 h-10 rounded-full bg-emerald-900 border-4 border-gold-400 shadow-lg flex items-center justify-center text-white text-xs font-bold shrink-0 z-10">
              {idx + 1}
            </div>

            <!-- Empty Spacer Side for Balance -->
            <div class="hidden sm:block w-[45%]"></div>

          </div>
        ))}
      </div>
    </div>

  </div>
</section>
