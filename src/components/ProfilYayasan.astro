---
import { YAYASAN_INFO, KEGIATAN_SANTRI, EKSTRAKURIKULER, LEMBAGA_NON_FORMAL } from '../data/psbData';

const GALERI_POTRET = [
  { url: '/galeri-1.png', caption: 'Kajian & Zikir Santri' },
  { url: '/galeri-2.png', caption: 'Sholat Berjamaah' },
  { url: '/galeri-3.png', caption: 'Pendalaman Kitab Salaf' },
  { url: '/galeri-4.png', caption: 'Lansekap Asri PPBH' },
];
---

<section id="profil" class="py-16 sm:py-20 bg-white text-slate-800 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="inline-block px-4 py-1.5 bg-emerald-100 text-emerald-900 rounded-full text-xs font-extrabold uppercase tracking-widest border border-emerald-200">
        Sejarah & Perjalanan
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-emerald-950 font-serif">
        Profil Yayasan Bidayatul Hidayah Mojogeneng
      </h2>
      <p class="text-slate-600 text-xs sm:text-base">
        Didirikan sejak tahun 1948 di Desa Mojogeneng, Jatirejo, Mojokerto. Membina ribuan alumni berkualitas yang tersebar di Nusantara.
      </p>
      <div class="w-16 h-1 bg-gold-500 mx-auto rounded-full"></div>
    </div>

    <!-- Sejarah Narrative & 4-Portrait Photo Frame Gallery -->
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">

      <!-- Sejarah Narrative Card -->
      <div class="lg:col-span-6 bg-light-soft p-6 sm:p-10 rounded-3xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <div class="space-y-4 text-slate-700 leading-relaxed text-xs sm:text-base">
          <div class="flex items-center gap-3 mb-2">
            <img src={YAYASAN_INFO.logoUrl} alt="Logo" class="w-10 h-10 object-contain shrink-0" />
            <div>
              <div class="text-[10px] text-gold-600 font-extrabold uppercase tracking-wider">Berdiri Sejak 1948</div>
              <div class="text-base sm:text-lg font-bold text-emerald-950 font-serif">Sejarah Pendirian Pesantren</div>
            </div>
          </div>

          <p>
            <strong>Yayasan Pondok Pesantren Bidayatul Hidayah</strong> merupakan Pondok Pesantren yang didirikan oleh seorang ulama alim dan Hafidh Al-Qur'an yaitu <strong class="text-emerald-900">{YAYASAN_INFO.pendiri}</strong> di Desa Mojogeneng, Kecamatan Jatirejo, Kabupaten Mojokerto, Jawa Timur pada tahun <strong>1948</strong>.
          </p>
          <p>
            Saat ini Pondok Pesantren Bidayatul Hidayah diasuh oleh <strong class="text-emerald-900">KH. Agus Salim Yahdi</strong> (Putra dari KH. Moh. Yahdi Mathlab) bersama <strong class="text-emerald-900">Kiai Nur Hasan</strong>. Berbekal ilmu dan keikhlasan beliau di bidang ilmu agama, Pesantren Bidayatul Hidayah mengalami perkembangan pesat.
          </p>
          <div class="p-3.5 bg-white rounded-2xl border-l-4 border-emerald-800 text-xs sm:text-sm text-emerald-900 font-semibold shadow-sm">
            Saat ini Pon Pes Bidayatul Hidayah mengelola <strong>14 Komplek Asrama</strong> serta unit pendidikan formal dan non-formal yang saling terintegrasi.
          </div>
        </div>

        <!-- Non-Formal Institutions -->
        <div class="pt-5 border-t border-slate-200 mt-5">
          <div class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider mb-2.5">Lembaga Non-Formal Pesantren:</div>
          <div class="flex flex-wrap gap-2">
            {LEMBAGA_NON_FORMAL.map(item => (
              <span class="px-3 py-1 bg-white text-emerald-950 text-[11px] font-bold rounded-xl border border-emerald-200 shadow-sm">
                {item}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- 4 Portrait Photos Side-By-Side in 1 Frame Card & Pengasuh Honor -->
      <div class="lg:col-span-6 space-y-6 flex flex-col justify-between">

        <!-- 4-Portrait Photo Frame Box -->
        <div class="bg-gradient-to-br from-emerald-950 via-emerald-900 to-emerald-950 p-4 sm:p-5 rounded-3xl border-2 border-gold-400/60 shadow-xl space-y-3">
          <div class="flex items-center justify-between border-b border-emerald-800 pb-2.5">
            <span class="px-2.5 py-1 bg-gold-400 text-emerald-950 text-[10px] font-extrabold rounded-md uppercase tracking-wider">
              Dokumentasi Otentik PPBH
            </span>
            <span class="text-[11px] text-emerald-300 font-medium">Mojogeneng, Mojokerto</span>
          </div>

          <!-- 4 Portrait Photos Grid (4 Column Side-By-Side) -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            {GALERI_POTRET.map((foto, idx) => (
              <div class="relative group rounded-2xl overflow-hidden border border-emerald-700/80 aspect-[3/5] bg-emerald-900">
                <img
                  src={foto.url}
                  alt={foto.caption}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-2 text-center">
                  <span class="text-[9px] font-bold text-gold-300 leading-tight w-full">{foto.caption}</span>
                </div>
              </div>
            ))}
          </div>

          <div class="text-[10px] text-emerald-300 text-center font-medium pt-1">
            4 Potret Kehidupan, Ibadah, & Lanskap Asri Pesantren Bidayatul Hidayah
          </div>
        </div>

        <!-- Pengasuh Brief Box -->
        <div class="bg-gradient-to-br from-emerald-900 to-emerald-950 text-white p-5 sm:p-6 rounded-3xl shadow-xl border border-gold-400/40 space-y-3">
          <div class="text-[10px] text-gold-300 font-extrabold uppercase tracking-widest">Amanah Kepengasuhan</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="bg-emerald-900/90 p-3 rounded-2xl border border-emerald-700">
              <div class="text-[9px] text-emerald-300 uppercase font-bold">PENDIRI PONPES (1948)</div>
              <div class="text-xs font-bold text-gold-300">{YAYASAN_INFO.pendiri}</div>
            </div>
            <div class="bg-emerald-900/90 p-3 rounded-2xl border border-emerald-700">
              <div class="text-[9px] text-emerald-300 uppercase font-bold">PENGASUH PONPES</div>
              <div class="text-xs font-bold text-white">KH. Agus Salim Yahdi & Kiai Nur Hasan</div>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Compact HP-Friendly Grid for Activities & Extracurriculars -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">

      <!-- Kegiatan Santri Harian (2-Column Grid on Mobile) -->
      <div class="bg-light-soft p-5 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-9 h-9 rounded-xl bg-emerald-900 text-gold-300 flex items-center justify-center text-lg font-bold shrink-0">📖</div>
          <div>
            <h3 class="text-lg sm:text-xl font-bold text-emerald-950 font-serif">Kegiatan Santri Harian</h3>
            <p class="text-[11px] sm:text-xs text-slate-500">Rutinitas keilmuan & ibadah santri</p>
          </div>
        </div>

        <!-- Grid 2-Kolom di HP agar Ringkas & Tidak Memanjang -->
        <div class="grid grid-cols-2 gap-2.5">
          {KEGIATAN_SANTRI.map(kegiatan => (
            <div class="flex items-center gap-2 text-[11px] sm:text-xs font-semibold text-slate-800 bg-white p-2.5 sm:p-3.5 rounded-2xl border border-slate-200/80 shadow-sm leading-tight">
              <span class="text-emerald-700 font-bold shrink-0">✓</span>
              <span class="truncate">{kegiatan}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Ekstrakurikuler & Bakat (2-Column Grid on Mobile) -->
      <div class="bg-light-soft p-5 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-9 h-9 rounded-xl bg-gold-500 text-emerald-950 flex items-center justify-center text-lg font-bold shrink-0">🏆</div>
          <div>
            <h3 class="text-lg sm:text-xl font-bold text-emerald-950 font-serif">Ekstrakurikuler & Bakat</h3>
            <p class="text-[11px] sm:text-xs text-slate-500">Wadah minat, bakat, & seni santri</p>
          </div>
        </div>

        <!-- Grid 2-Kolom di HP agar Ringkas & Tidak Memanjang -->
        <div class="grid grid-cols-2 gap-2.5">
          {EKSTRAKURIKULER.map(ekstra => (
            <div class="flex items-center gap-2 text-[11px] sm:text-xs font-semibold text-slate-800 bg-white p-2.5 sm:p-3.5 rounded-2xl border border-slate-200/80 shadow-sm leading-tight">
              <span class="text-gold-600 font-bold shrink-0">★</span>
              <span class="truncate">{ekstra}</span>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>
